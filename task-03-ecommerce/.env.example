# ─── Server ───
NODE_ENV=development
PORT=5003

# ─── Database ───
MONGO_URI=mongodb://127.0.0.1:27017/prodigy_store

# ─── Auth ───
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5500

# ─── Seed Users (for `npm run seed`) ───
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@etfruit.com
ADMIN_PASSWORD=Admin@1234

SELLER_USERNAME=highland
SELLER_EMAIL=seller@etfruit.com
SELLER_PASSWORD=Seller@1234

CUSTOMER_USERNAME=sara
CUSTOMER_EMAIL=customer@etfruit.com
CUSTOMER_PASSWORD=Customer@1234

# ─── Chapa (Ethiopian payments) ───
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=http://localhost:5003/api/orders/verify
CHAPA_RETURN_URL=http://localhost:5500/payment-success.html

# ─── Email (SMTP, optional) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Etfruit <noreply@etfruit.com>